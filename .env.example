# Copy this file to .env (same folder you run the app from) and fill in the password.
# .env is git-ignored. Lines are KEY=value; no quotes needed. If your password contains a
# backslash (\), write it as \\.
APP_OTP_SENDER=messagecentral
APP_OTP_MC_PASSWORD=your-message-central-password
# APP_OTP_MC_CUSTOMER_ID=C-DC8D1C144CA446C   (already the default)
# APP_OTP_MC_FLOW_TYPE=SMS                    (or WHATSAPP)

# --- Dispatch (assigns a professional to each booking) ---
# Leave these commented to run without dispatch (bookings stay "Finding a professional").
# To connect: start the local stack first (urbanserve-infra/compose: docker compose up -d --build),
# then uncomment:
# APP_DISPATCH_TRANSPORT=sqs
# APP_SQS_ENDPOINT=http://localhost:9324
# APP_SQS_BOOKING_REQUESTED_URL=http://localhost:9324/000000000000/booking-requested
# APP_SQS_BOOKING_CANCELLED_URL=http://localhost:9324/000000000000/booking-cancelled
# APP_SQS_BOOKING_ASSIGNMENT_URL=http://localhost:9324/000000000000/booking-assignment

