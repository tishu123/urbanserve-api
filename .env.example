# Copy this file to .env (same folder you run the app from) and fill in the password.
# .env is git-ignored. Lines are KEY=value; no quotes needed. If your password contains a
# backslash (\), write it as \\.
APP_OTP_SENDER=messagecentral
APP_OTP_MC_PASSWORD=your-message-central-password
# APP_OTP_MC_CUSTOMER_ID=C-DC8D1C144CA446C   (already the default)
# APP_OTP_MC_FLOW_TYPE=SMS                    (or WHATSAPP)
